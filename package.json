{
  "name": "en-vrille",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm run dev -w @en-vrille/api\" \"npm run dev -w @en-vrille/web\"",
    "build": "npm run build -w @en-vrille/api && npm run build -w @en-vrille/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "desktop:build": "npm run build -w @en-vrille/desktop",
    "desktop:dist": "npm run dist:win -w @en-vrille/desktop",
    "desktop:test": "npm run test -w @en-vrille/desktop && npm run test:app -w @en-vrille/desktop",
    "steam:prepare": "npm run steam:prepare -w @en-vrille/desktop",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "capture:store": "tsx scripts/capture-store.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
