{
  "name": "@en-vrille/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "EN VRILLE ! — client de jeu Windows avec scène locale et manettes Web",
  "author": "ERubis",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "node scripts/build-renderer.mjs && electron .",
    "build": "node scripts/build-renderer.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never && node scripts/write-checksums.mjs",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "steam:prepare": "node scripts/prepare-steam.mjs"
  },
  "build": {
    "electronVersion": "45.2.1",
    "appId": "fr.erubis.envrille",
    "productName": "EN VRILLE !",
    "executableName": "EN-VRILLE",
    "copyright": "Copyright © ERubis",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "security.mjs",
      "steam.mjs",
      "renderer/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "EN-VRILLE-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "packElevateHelper": false,
      "allowElevation": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "EN VRILLE !",
      "artifactName": "EN-VRILLE-${version}-Setup-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "EN-VRILLE-${version}-Portable-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
