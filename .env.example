# Copier vers .env pour le développement (ne jamais commiter ce fichier).
# En production, saisir les valeurs dans Environment variables de Portainer.
PUBLIC_URL=https://envrille.erubis.fr
# Seul port publié. Proxy sur la même machine : 127.0.0.1 ; sinon adresse LAN du serveur.
APP_BIND=127.0.0.1
APP_PORT=8080
IMAGE_TAG=stable
WEB_IMAGE=ghcr.io/empereurrubis/en-vrille-web
API_IMAGE=ghcr.io/empereurrubis/en-vrille-api
POSTGRES_DB=en_vrille
POSTGRES_USER=en_vrille
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_ALEATOIRE
# Au moins 32 caractères aléatoires distincts, générés avec un gestionnaire de mots de passe.
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_CARACTERES
ADMIN_TOKEN=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE_DE_64_CARACTERES
# Délai de retour de l'écran PC avant expiration du salon (5 à 3600 secondes).
DISPLAY_RECONNECT_SECONDS=120
# Proxy HTTPS externe + Nginx de la stack ; mettre 1 si Nginx est exposé directement.
TRUST_PROXY=2
# Développement : PUBLIC_URL=http://localhost:5173 (ou http://IP_LAN_DU_PC:5173).
# Sans PGHOST/DATABASE_URL : sauvegarde JSON locale dans DATA_DIR (ignorée par Git).
# Avec PostgreSQL local, décommenter ces variables :
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=en_vrille
# PGUSER=en_vrille
# PGPASSWORD=mot_de_passe_local
# PORT=3001
# DATA_DIR=../../data
